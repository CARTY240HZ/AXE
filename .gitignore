# AXE - .gitignore
# Runtime state (generated by the tool at runtime, not source)

# Logs diarios del motor
**/axe_log_*.log
**/lw_log_*.log

# Backups de registro (generados al aplicar tweaks)
**/Backups/*.reg

# Estado de startup (backup de autoruns, mutable)
**/startup_disabled.json

# Directorio de datos legacy pre-rebrand (migrado a AXE/ en runtime; si queda huérfano, ignorar)
**/LWSuite/

# Datos de runtime cuando el motor se ejecuta FUERA de la raiz: 05-core deriva AXERoot
# del script, asi que correr dist/AXE.ps1 crea dist/AXE/ y los tests crean src/AXE/.
# Es estado mutable (logs + tweak_state.json), no fuente.
AXE/dist/AXE/
AXE/src/AXE/

# Lineas base del benchmark (subproyecto C): estado de runtime por maquina, como
# tweak_state.json. Nunca es fuente, y ademas trae medidas del equipo del usuario.
# El patron cubre las tres raices posibles (AXE/AXE/, AXE/dist/AXE/, AXE/src/AXE/) porque
# 05-core deriva AXEData del script que se ejecute.
**/AXE/bench/

# Renders del harness GUI (AXE_GUITEST / AXE_GUISHOW): artefactos de test
AXE/dist/axe_render.png
AXE/dist/axe_shown.png

# Artefactos de test side-effect del rewrite v6 abandonado (directorio ya no existe)
LWSuite-v6/

# Ficheros locales del equipo, no fuente del proyecto:
#   winutil.exe  - binario de terceros (WinUtil), descargado para comparar. No es nuestro, no se
#                  redistribuye y no tiene por que viajar en el repo.
#   .zcode/      - metadata de herramienta local.
# Ya estaban sin trackear (0 commits los tocan); esto solo evita que salgan como '??' en cada
# git status y que acaben dentro por un 'git add .' distraido.
winutil.exe
.zcode/
