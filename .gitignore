# LW Suite - .gitignore
# Runtime state (generated by the tool at runtime, not source)

# Logs diarios del motor
**/lw_log_*.log

# Backups de registro (generados al aplicar tweaks)
**/Backups/*.reg

# Estado de startup (backup de autoruns, mutable)
**/startup_disabled.json

# Artefactos de test side-effect (dir de datos creado al cargar Logging.ps1)
LWSuite-v6/src/LWSuite/

# Build output de C# (cuando exista)
LWSuite-v6/LWSuite.Gui.dll
LWSuite-v6/src/gui-cs/bin/
LWSuite-v6/src/gui-cs/obj/
LWSuite-v6/.vs/

# Manifest se versiona SIEMPRE (es build artifact pero debe ir en commits por seguridad)
# No ignoramos config/manifest.json
